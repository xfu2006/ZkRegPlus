\def\hp{\hspace*{0.1in}}
\begin{footnotesize}
\begin{algorithm}[bt]
\SetKwData{Left}{left}\SetKwData{This}{this}\SetKwData{Up}{up}
\SetKwFunction{Union}{Union}\SetKwFunction{FindCompress}{FindCompress}
$(\pkkzg,\vkkzg) \leftarrow \cqsetup(\secparam, N, n):$  \newline
Sample $s$ from $\F$ and 
compute $((\myvec{M},\myvec{P}), (\myvec{D}, [a]_2)) \leftarrow
	\SetupQANIZK(N, n, s)$. \newline
Let $\pkkzg \leftarrow \left(\big([s^i]_1, [s^i]_2\big)_{i=1}^N, 
\myvec{M}, 
\myvec{P}   
\right)$. \newline
Let $\vkkzg \leftarrow \left(
[1]_2,
[s]_2,
\myvec{D},
[a]_2 \right)$. \newline
Return $(\pkkzg,\vkkzg)$.\\
$(\pk,\vk,\Commit_{\myvec{T}}) 
		\leftarrow \cqpreproc(\myvec{T}, r_T, \pkkzg,\vkkzg)$: \newline
	Parse $\pkkzg$ and $\vkkzg$ as shown in $\cqsetup$. \newline
	Define $T(X) = \sum_{i=1}^N \myvec{T}_i L_{N,i}(X)$,
	and $\hat{T}(X) = T(X) + r_T z_\H(X)$. \newline
	For $i \in [N]$ define $Q_i(X) = 
	\frac{L_{N,i}(X) \cdot T(X) - \myvec{T}_i 
	\cdot L_{N,i}(X)}{Z_{\H}(X)}$. \newline
	Compute $[\hat{T}(s)]_1, [\hat{T}(s)]_2$ using $\pkkzg$. \newline
	Compute $\big([Q_i(s)]_1\big)_{i=1}^N$ using $\pkkzg$. \newline
	Let $\pk = \pkkzg \concat 
		[\hat{T}(s)]_1 \concat \left([Q_i(s)]_1,L_{N,i}(s)\right)_{i=1}^N$
			$\concat \left(L_{\n,i}(s)\right)_{i=1}^n$
			$\concat [z_\Vtwo(s)]_1 \concat [z_\H(s)]_1$
			$\concat z_\V(X)$.  \newline
	let $\vk =  \vkkzg \concat [\hat{T}(s)]_2$
$\concat [z_{\H}(s)]_2 \concat  [z_{\V}(s)]_1$. \newline
	Return $(\pk, \vk, \Commit_{\myvec{T}})$. \\
$(\Commit_\myvec{t}, \prf) \leftarrow \cqprove(\pk, \myvec{t}, r_t)$: \newline
	(1) Parse $\pk$ and $\vk$ as shown in $\cqpreproc$. 
	Sample $r_A, r_B, r_m$ from $\F$.  \newline
	(2) Let $\hat{t}(X) = \sum_{i=1}^n \myvec{t_i} L_{\n,i}(X) + r_t z_\Vtwo(X)$.
	Compute $[\hat{t}(s)]_1$.
	\newline
	(3) Define $\myvec{m} \in \F^{N}$ s.t. each $\myvec{m}_i$ 
	is the multiplicity of $\myvec{T}_i$ in $\myvec{t}$. 
	Define $\hat{m}(X) = \sum_{i=1}^{N} \myvec{m}_i L_{N,i}(X) + r_m z_\H(X)$. 
	Compute $[\hat{m}(s)]_1$. \newline
	(4) Fiat-Shamir: $\beta = \hash(\vk \concat [\hat{t}(s)]_1 \concat 
		[\hat{m}(s)]_1)$. \newline
	(5) Define $\myvec{A} \in \F^{N}$ s.t. for each $i\in [N]:$
	$\myvec{A}_i = \myvec{m}_i/(\myvec{T}_i + \beta)$.
	Define $A(X) = \sum_{i=1}^N$ $\myvec{A}_i L_{N,i}(X)$,
	and $\hat{A}(X) = A(X) + r_A z_\H(X)$.
	Compute $[\hat{A}(s)]_1$. \newline
	(6) Define $Q_A(X) = (A(X) (T(X) + \beta) - m(X))/z_\H(X)$.
	Compute $[Q_A(s)]_1$ using the $[Q_i(s)]_1$ in $\pk$.
	Then compute $[\hat{Q_A}(s)]_1 \leftarrow [Q_A(s)]_1 + r_A[T(s)]_1$
		 $+ r_T[A(s)]_1$ $+ r_A r_T [z_\H(s)]_1$ $+ [r_A \beta -r_m]_1$.
	\newline
	(7)  Define $\myvec{B} \in \F^n$ s.t. 
	$\myvec{B}_i = 1/(\myvec{t}_i + \beta)$ for each $i\in [n]$.
	Define $B(X) = \sum_{i=1}^n B_i \cdot L_{\n,i}(X)$, 
	and $\hat{B}(X) = B(X) + r_B z_\Vtwo(X)$.
	Compute $[\hat{B}(s)]_1$.
	\newline
	(8) computes $\hat{Q_B}(X) \leftarrow 
		\frac{\hat{B}(X)(\hat{t}(X) + \beta) - 1}{z_\V(X)}$.
	Compute $[\hat{Q_B}(s)]_1$. \newline
	(9) Fiat-Shamir $(\gamma, \eta) \leftarrow \hash(\beta \concat
		[\hat{A}(s)]_1 \concat	
		[\hat{Q_A}(s)]_1 \concat	
		[\hat{B}(s)]_1 \concat	
		[\hat{Q_B}(s)]_1)$. \newline
	(10) Compute 
	$B_\gamma \leftarrow \hat{B}(\gamma)$.
	$Z_\gamma \leftarrow z_\V(\gamma)$.
	Compute $D(X) = B_\gamma(\hat{t}(X) + \beta) - 
		1 - \hat{Q_B}(X)Z_\gamma$.
	Compute $P(X) = \frac{(B(X)-B_\gamma) + \eta D(X)+\eta^2(z_\V(X) - Z_\gamma)}{X-\gamma}$.
	Compute $[P(s)]_1$.
	\newline
	(11) Let $\myvec{w} = \myvec{A} \concat r_A \concat \myvec{B} \concat
		r_B$, and compute $\prfqa \leftarrow \myvec{w}^\intercal \myvec{P}$.
	\newline
	(12) Let $\prf = \big(
				[\hat{m}(s)]_1, 
				[\hat{A}(s)]_1, 
				[\hat{Q_A}(s)]_1, 
				[\hat{B}(s)]_1, 
				[\hat{Q_B}(s)]_1, 
				[P(s)]_1, 
				\prfqa,
				B_\beta,
				Z_\gamma
			\big)$.
			Return $([\hat{t}(s)]_1, \prf)$.

$1/0 \leftarrow \cqverify(\vk, 
	\Commit_{\myvec{t}}, \prf):$  \newline
Parse $\prf$ as $(\bm, \ba, \bqa, \bb, \bqb, \bp, \prfqa, B_\beta,Z_\gamma)$.
Parse $\vk$ as shown in $\cqpreproc$.
Compute $\beta \leftarrow \hash(\vk \concat$ $\bt \concat \bm)$,  
	$(\gamma, \eta) \leftarrow$ $\hash\big(\beta \concat$
		$\ba \concat	
		\bqa \concat	
		\bb \concat	
		\bqb\big)$.  
Return true if and only if all of the following checks pass. \newline
(1) $	
		e\left(\ba, [\hat{T}(s)]_2\right) = 
		e\left(\bqa, [z_\H(s)]_2\right) ~
		e\left(\bm - \beta \ba, [1]_2\right)
	$\newline	
(2) $e\left(\prfqa, [a]_2\right) = e\left(\ba,\myvec{D}_1\right) 
e\left(\bb, \myvec{D}_2\right)$. \newline
(3) $e\Big(\bb-[B_\gamma]_1+\eta \left(B_\gamma(\Commit_{\myvec{t}}+[\beta]_1) - [1]_1 - Z_\gamma\bqb\right)$ $+ \eta^2\left([z_\V(s)]_1-Z_\gamma\right), 
[1]_2\Big)$ $=$ $e\left(\bp, [s-\gamma]_2\right)$ \newline
\caption{Zero Knowledge $\cq$ Protocol}
\label{fig_zkcq}
\end{algorithm}
\end{footnotesize}


\subsection{Zero Knowledge $\cq$ Protocol}
In Figure\ \ref{fig_zkcq} we present the details
of the zero knowledge $\cq$ protocol.
As the look-up table $\myvec{T}$ is secret,
we split the setup process into two parts:
a trusted set-up which generates KZG polynomial
commitment keys, and a pre-process procedure
which generates the augment information (e.g., cached
quotients) for the $\cq$ protocol. Given 
$\Commit_{\myvec{T}}$, which is to be re-used
multiple times in multiple lookup proofs,
the prover and verifier needs to run a {\em one-time}
proof for (1) the prover's knowledge of $\myvec{T}$,
and (2) $\Commit_{\myvec{T}}$ is a well formed
commitment of $\myvec{T}$ (i.e., the size of
$\myvec{T}$ is bounded by $N$). This can be trivially
accomplished re-using the QA-NIZK proof, and we skip the details here.
%(see $\cqoneprove$ and $\cqoneverify$).

All other group elements in
$\pkkzg$ other than the
$\big([s^i]_1\big)_{i=1}^N$
can be computed from it, thus does not increase
power of the soundness adversary.
Note that in the $\pk$, the $z_\V(X)$ represents the vector of
co-efficients of $z_\V(X)$.\footnote{As $n$ is not guaranteed
to be a power of $2$, we do not have the convenience
as $z_\Vtwo(X) = X^\n -1$.}
The $\cqpreproc$ mainly computes the information (cached quotients)
dependent on $\myvec{T}$. This step can be merged with
$\cqsetup$ if $\myvec{T}$ is public, to avoid costly
group FFT. However, notice that the asymptotic complexity (in terms
of group operations)
of $\cqpreproc$ is still $O(N\log(N))$, the same as the original
$\cq$ protocol. However it incurs a higher
field operation cost of $O(n\log^2(n))$ for
pre-computing $z_\V(X)$, which is negligible compared with group operation
cost when $n$ is small.

We now elaborate the design idea of the $\cqprove()$.
It follows the basic idea of \cite{Hab22}, that 
$\myvec{t} \lookup \myvec{T}$ if and only if there exists a
vector $\myvec{m}$ s.t. $\myvec{m}_i$ represents the multiplicity 
$\myvec{T}_i$ in $\myvec{t}$. For a uniformly sampled
$\beta$:
\begin{equation} \label{eq_hab}
	\sum_{i=1}^N \frac{\myvec{m}_i}{\myvec{T}_i +\beta} = 
	\sum_{i=1}^n \frac{1}{\myvec{t}_i+\beta}  
\end{equation}

Then the protocol (steps 1-7) follows $\cq$. It declares
polynomials $A(X)$ and $B(X)$ to model the LHS and RHS
of Equation\ \ref{eq_hab}. For example, it computes $Q_A(X)$
s.t. $A(X)(T(X) + \beta) - m(X) = Q_A(X) z_\H(X)$. The difference
is that all polynomials are masked by a blind factor, e.g., 
$\hat{A}(X) = A(X) + r_A z_\H(X)$. This is also the same
as \cite{MatrixLookup,CCG23}. Note that $[\hat{Q_A}(s)]_1$
can be computed using the cached $([Q_i(s)]_1)_{i=1}^N$ and 
thus only costing $O(n)$ given $\myvec{A}$ is sparse.

At Steps 8-10, we adopt the technique introduced in \cite{MatrixLookup}
so that we can save two field elements for proving
$\hat{B}(X)(\hat{t}(X) + \beta) -1 = \hat{Q_B}(X) z_\V(X)$.
The basic idea is to let the verifier sample $\gamma$ and then
provide $B_\gamma = \hat{B}(\gamma)$.
Define $D(X) = B_\gamma(\hat{t}(X) + \beta) - 1 - \hat{Q_B}(X) z_\V(\gamma)$.
It is clear that $D(X)$ evaluates to $0$ at $\gamma$.
Note that $\hat{B}(X) - B_\gamma$ also evaluates to $0$ at
$\gamma$. Let verifier raise another random challenge $\eta$,
the two polynomial checks can be batched as: there exists
a $P(X)$ s.t. the following is true by applying the KZG polynomial
commitment check:
\[
	(B(X) - B_\gamma) + \eta (D(X) - 0) = P(X)(X - \gamma)
\]

Consider the cost of computing $z_\V(\gamma)$ at verifier.
It incurs $O(n)$ field operations. To cut the asymptotic verifier
complexity to $O(1)$, instead, we let the prover
compute $Z_\gamma = z_\V(\gamma)$ and pass the value
in proof (which incurs one more field element than cq++).
Then we need to provide a KZG proof for it, which again, we can
fold into $P(X)$. In this case, we re-define $P(X)$ as the proof
polynomial for the following folded KZG checks:
\[
	(B(X) - B_\gamma) + \eta (D(X) - 0) + \eta^2(z_\V(X)-Z_\gamma) 
	= P(X)(X - \gamma)
\]

Then it remains to prove that the sum of $\myvec{A}$ is
the same as $\myvec{B}$. Our protocol then departs from
$\cq$ and $\cq+$ \cite{MatrixLookup}.  The earlier work
including \cite{cq,MatrixLookup}
applies the Aurora Lemma \cite[Remark 5.6]{aurora19}, and it needs
$n$ to be the size of a {\em multiplicative subgroup} of $\F$.
By Lagrange theorem, $n$ should divide $|\F|$, and 
for example $n$ is (de-factor) required to be a power of
$2$ in \cite{MatrixLookup}. In this work, this restriction is removed
because we use the QA-NIZK.

Steps 11-12 accomplish the QA-NIZK proof with $2n$ (instead of
$2\n$) group operations (because $\myvec{A}$ is sparse).
We end up with a proof of $7$ $\G_1$ $+2$ $\F$ elements,
which is the same concrete prover cost (and better
when $n\neq \n$) compared with 
cq++ in \cite{MatrixLookup} and 
7 pairings in verifier (1 more than cq++).

To save the verifier cost,
Equations (1) and (3) of $\cqverify$ can be batched using 
a random $\mu$ as following:
\begin{small}
\begin{eqnarray*}
 & & e\Big(\bb - [B_\gamma]_1 + 
 \eta \big(B_\gamma(\Commit_{\myvec{t}} + [\beta]_1) - [1]_1 
 	- Z_\gamma\bqb\big)  
 + \\
 & & ~~\eta^2([z_\V(s)]_1 - [Z_\gamma]_1) + \mu(\bm - \beta \ba), 
 	[1]_2\Big)  \\
 & & e\left(\mu \bqa, [z_\H(s)]_2\right)
 \\
 &=& e\left(\bp, [s-\gamma]_2\right) ~e\left(\mu\ba, [\hat{T}(s)]_2\right) ~
\end{eqnarray*}
\end{small}

