\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Change of approximation effectiveness with file size (over \textsc  {Mal}): fractions of (rule, file) pairs discharged at each tier across file sizes. $\texttt  {CP}$'s share declines and $\texttt  {SDE}$/$\texttt  {DFA}$ grow as files enlarge, though the $\texttt  {DFA}$ fraction stays negligible throughout.}}{2}{table.3}\protected@file@percent }
\newlabel{tab:eff-size}{{3}{2}{Change of approximation effectiveness with file size (over \textsc {Mal}): fractions of (rule, file) pairs discharged at each tier across file sizes. $\cp $'s share declines and $\sde $/$\dfa $ grow as files enlarge, though the $\dfa $ fraction stays negligible throughout}{table.3}{}}
