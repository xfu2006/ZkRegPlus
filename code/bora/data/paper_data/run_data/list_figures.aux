\newlabel{tab:datasets}{{1}{2}{Evaluation datasets: \textsc {Mal} (malware scanning), \textsc {Dna} (genomic variants), and \textsc {Dlp} (e-mail DLP)}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Ruleset-size scalability (input fixed), per folding step, on \textsc  {ClamAV} (left) and \textsc  {MS-DLP} (right). \emph  {Top:} absolute circuit size with the single-rule framework floor (dotted; $8.19$\,M R1CS for \textsc  {ClamAV}, $0.08$\,M for \textsc  {MS-DLP}); growing the ruleset to the full $38{,}875$ (\textsc  {ClamAV}) / $9{,}861$ (\textsc  {MS-DLP}) rules grows the circuit far slower than the rule count. \emph  {Bottom:} net circuit cost \emph  {per rule per input byte}---cumulative R1CS above the floor divided by cumulative rule count times per-step input length---moving from $0.45\times 10^{-3}$ to $0.76\times 10^{-3}$ (\texttt  {gdb}) and $0.25\times 10^{-3}$ to $0.44\times 10^{-3}$ (\texttt  {readelf}) R1CS per rule-byte (\textsc  {ClamAV}) and $1448.30\times 10^{-3}$ to $538.78\times 10^{-3}$ (\texttt  {email1}) and $14.82\times 10^{-3}$ to $1.53\times 10^{-3}$ (\texttt  {email2}) R1CS per rule-byte (\textsc  {MS-DLP}) between $10\%$ of the ruleset and the full set. For the same \textsc  {MS-DLP} ruleset, \textsc  {Zombie} emits $77{,}463{,}552$ R1CS in total; dividing by the $2000$-byte input and the same $9{,}861$ rules gives $\sim $$3.93$ R1CS per rule-byte, the same normalization applied to BORA.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:scale-regex}{{1}{2}{Ruleset-size scalability (input fixed), per folding step, on \textsc {ClamAV} (left) and \textsc {MS-DLP} (right). \emph {Top:} absolute circuit size with the single-rule framework floor (dotted; $8.19$\,M R1CS for \textsc {ClamAV}, $0.08$\,M for \textsc {MS-DLP}); growing the ruleset to the full $38{,}875$ (\textsc {ClamAV}) / $9{,}861$ (\textsc {MS-DLP}) rules grows the circuit far slower than the rule count. \emph {Bottom:} net circuit cost \emph {per rule per input byte}---cumulative R1CS above the floor divided by cumulative rule count times per-step input length---moving from $0.45\times 10^{-3}$ to $0.76\times 10^{-3}$ (\ttt {gdb}) and $0.25\times 10^{-3}$ to $0.44\times 10^{-3}$ (\ttt {readelf}) R1CS per rule-byte (\textsc {ClamAV}) and $1448.30\times 10^{-3}$ to $538.78\times 10^{-3}$ (\ttt {email1}) and $14.82\times 10^{-3}$ to $1.53\times 10^{-3}$ (\ttt {email2}) R1CS per rule-byte (\textsc {MS-DLP}) between $10\%$ of the ruleset and the full set. For the same \textsc {MS-DLP} ruleset, \textsc {Zombie} emits $77{,}463{,}552$ R1CS in total; dividing by the $2000$-byte input and the same $9{,}861$ rules gives $\sim $$3.93$ R1CS per rule-byte, the same normalization applied to BORA}{figure.1}{}}
