\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Lookup-table composition across datasets. Column \emph  {M} is millions of entries. Each \% is of that dataset's populated entries; TOTAL \% is of the $2^{28}$ capacity. $^\dagger $range table $=2^{\text  {range2\_bit}}$ (26 / 27 / 25 for \textsc  {Mal}/\textsc  {Dna}/\textsc  {Dlp}), sized by the maximum document offset. The $(\cdot /\cdot /\cdot )$ after \emph  {DFA} is the number of DFAs folded in for rules that frequently fail SDE, per dataset. BORA re-writes \texttt  {(kw1|...kwn).\{0,N\}pat} in \textsc  {Dlp} to disjunction of $n$ rules for improved SDE accuracy, thus expanding from $136$ to $9861$.}}{3}{table.5}\protected@file@percent }
\newlabel{tbl:lkup}{{5}{3}{Lookup-table composition across datasets. Column \emph {M} is millions of entries. Each \% is of that dataset's populated entries; TOTAL \% is of the $2^{28}$ capacity. $^\dagger $range table $=2^{\text {range2\_bit}}$ (26 / 27 / 25 for \textsc {Mal}/\textsc {Dna}/\textsc {Dlp}), sized by the maximum document offset. The $(\cdot /\cdot /\cdot )$ after \emph {DFA} is the number of DFAs folded in for rules that frequently fail SDE, per dataset. BORA re-writes \ttt {(kw1|...kwn).\{0,N\}pat} in \textsc {Dlp} to disjunction of $n$ rules for improved SDE accuracy, thus expanding from $136$ to $9861$}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Per-circuit cost profile. Each dataset is discharged by a small set of circuits. \emph  {input} is the bytes processed per folding step. Each $c_i \in (c_1,c_2,c_3,c_4)$ is the per-input-byte R1CS constraints of the four components of a circuit.Each $c_i$ is shown as \emph  {raw\,(adjusted)}: the \emph  {adjusted} value moves the \emph  {measured} log-up query cost in $c_4$ and charges it to each tier in proportion to its data-column size, so $c_1/c_2/c_3$ reflect the all-in per-byte cost and $c_4$ retains only folding overhead and the processing of Logup share of lookup table. }}{3}{table.6}\protected@file@percent }
\newlabel{tbl:component-cost}{{6}{3}{Per-circuit cost profile. Each dataset is discharged by a small set of circuits. \emph {input} is the bytes processed per folding step. Each $c_i \in (c_1,c_2,c_3,c_4)$ is the per-input-byte R1CS constraints of the four components of a circuit.Each $c_i$ is shown as \emph {raw\,(adjusted)}: the \emph {adjusted} value moves the \emph {measured} log-up query cost in $c_4$ and charges it to each tier in proportion to its data-column size, so $c_1/c_2/c_3$ reflect the all-in per-byte cost and $c_4$ retains only folding overhead and the processing of Logup share of lookup table}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces End-to-end prover performance. \emph  {Corpus} is the bytes actually folded: \textsc  {Dna} packs each base of its chr17 sequence into a nibble (half a byte), halving it to the $813.8$\,KB shown, while the $829.2$\,KB \textsc  {Mal} results from padding each chunk to $128$\,KB. \emph  {Stage 1} (main folding) is the corpus-scaling cost: circuit selection $+$ commit fixed witness $+$ folding. \emph  {Total\,/\,Wall (jobs)} reports the summed CPU-time over the parallel jobs and the wall-clock time; for balanced jobs the wall-clock is ${\approx }\,$Total$/$Jobs. \emph  {Stage 2: Compression} computes the main-circuit SNARK proof, the QA-NIZK proof, the cycle-pairing fold, and the resulting batch proof. It is a fixed per-job cost, and all timings exclude the one-time key setup. The bottom row shows the size and verification cost of one batch proof (mainly the two Groth16 SNARK proofs); this per-job batch proof is constant size and independent of corpus and rule-set size. A run emits one batch proof per job, as jobs split a corpus to save wall time.}}{3}{table.7}\protected@file@percent }
\newlabel{tbl:overall-perf}{{7}{3}{End-to-end prover performance. \emph {Corpus} is the bytes actually folded: \textsc {Dna} packs each base of its chr17 sequence into a nibble (half a byte), halving it to the $813.8$\,KB shown, while the $829.2$\,KB \textsc {Mal} results from padding each chunk to $128$\,KB. \emph {Stage 1} (main folding) is the corpus-scaling cost: circuit selection $+$ commit fixed witness $+$ folding. \emph {Total\,/\,Wall (jobs)} reports the summed CPU-time over the parallel jobs and the wall-clock time; for balanced jobs the wall-clock is ${\approx }\,$Total$/$Jobs. \emph {Stage 2: Compression} computes the main-circuit SNARK proof, the QA-NIZK proof, the cycle-pairing fold, and the resulting batch proof. It is a fixed per-job cost, and all timings exclude the one-time key setup. The bottom row shows the size and verification cost of one batch proof (mainly the two Groth16 SNARK proofs); this per-job batch proof is constant size and independent of corpus and rule-set size. A run emits one batch proof per job, as jobs split a corpus to save wall time}{table.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Ruleset-size scalability (input fixed), per folding step, on \textsc  {ClamAV} (left) and \textsc  {MS-DLP} (right). \emph  {Top:} absolute circuit size with the single-rule framework floor (dotted; $0.28$\,M R1CS for \textsc  {ClamAV}, $0.08$\,M for \textsc  {MS-DLP}); growing the ruleset to the full $300$ (\textsc  {ClamAV}) / $494$ (\textsc  {MS-DLP}) rules grows the circuit far slower than the rule count. \emph  {Bottom:} net circuit cost \emph  {per rule per input byte}---cumulative R1CS above the floor divided by cumulative rule count times per-step input length---falling from $18.11\times 10^{-3}$ to $18.11\times 10^{-3}$ (\texttt  {gdb}) and $18.42\times 10^{-3}$ to $18.42\times 10^{-3}$ (\texttt  {readelf}) R1CS per rule-byte (\textsc  {ClamAV}) and $556.39\times 10^{-3}$ to $556.39\times 10^{-3}$ (\texttt  {email1}) and $323.59\times 10^{-3}$ to $27.24\times 10^{-3}$ (\texttt  {email2}) R1CS per rule-byte (\textsc  {MS-DLP}) at the full set. For the same \textsc  {MS-DLP} ruleset, \textsc  {Zombie} emits $3{,}407{,}872$ R1CS in total; dividing by the $2000$-byte input and the same $494$ rules gives $\sim $$3.45$ R1CS per rule-byte, the same normalization applied to BORA.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:scale-regex}{{1}{4}{Ruleset-size scalability (input fixed), per folding step, on \textsc {ClamAV} (left) and \textsc {MS-DLP} (right). \emph {Top:} absolute circuit size with the single-rule framework floor (dotted; $0.28$\,M R1CS for \textsc {ClamAV}, $0.08$\,M for \textsc {MS-DLP}); growing the ruleset to the full $300$ (\textsc {ClamAV}) / $494$ (\textsc {MS-DLP}) rules grows the circuit far slower than the rule count. \emph {Bottom:} net circuit cost \emph {per rule per input byte}---cumulative R1CS above the floor divided by cumulative rule count times per-step input length---falling from $18.11\times 10^{-3}$ to $18.11\times 10^{-3}$ (\ttt {gdb}) and $18.42\times 10^{-3}$ to $18.42\times 10^{-3}$ (\ttt {readelf}) R1CS per rule-byte (\textsc {ClamAV}) and $556.39\times 10^{-3}$ to $556.39\times 10^{-3}$ (\ttt {email1}) and $323.59\times 10^{-3}$ to $27.24\times 10^{-3}$ (\ttt {email2}) R1CS per rule-byte (\textsc {MS-DLP}) at the full set. For the same \textsc {MS-DLP} ruleset, \textsc {Zombie} emits $3{,}407{,}872$ R1CS in total; dividing by the $2000$-byte input and the same $494$ rules gives $\sim $$3.45$ R1CS per rule-byte, the same normalization applied to BORA}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Reef per-bucket cost vs.\ BORA on chr17~$\times $~NCBI (27{,}500 regexes). Both systems are compared on the \emph  {net} step-folding cost only, excluding commitment, setup, and IVC proof compression, for a fair comparison. For Reef, net $=$ witness generation $+$ Nova prove $+$ SAFA solve (\texttt  {fa\_solver}); it excludes the fixed floor (the 4.3\,GB commitment load, SNARK setup, consistency proof, and related one-time costs). For BORA, net $=$ the Phase~1 circuit selection and non-deterministic advice generation, and Phase~2 main-folding step cost, excluding the Groth16 IVC proof compression as well as setup and commitment. Estimate1 uses each bucket's measured per-run mean times its population count; Estimate2 uses the minimum measured per-run mean (proj\_512k) times bucket count as a counterfactual floor.}}{4}{table.8}\protected@file@percent }
\newlabel{tab:dna-reef-bora}{{8}{4}{Reef per-bucket cost vs.\ BORA on chr17~$\times $~NCBI (27{,}500 regexes). Both systems are compared on the \emph {net} step-folding cost only, excluding commitment, setup, and IVC proof compression, for a fair comparison. For Reef, net $=$ witness generation $+$ Nova prove $+$ SAFA solve (\texttt {fa\_solver}); it excludes the fixed floor (the 4.3\,GB commitment load, SNARK setup, consistency proof, and related one-time costs). For BORA, net $=$ the Phase~1 circuit selection and non-deterministic advice generation, and Phase~2 main-folding step cost, excluding the Groth16 IVC proof compression as well as setup and commitment. Estimate1 uses each bucket's measured per-run mean times its population count; Estimate2 uses the minimum measured per-run mean (proj\_512k) times bucket count as a counterfactual floor}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Zombie prover cost on the MS-DLP international SIT rules (Spartan NIZK, two-pattern proximity circuit), totalled over all 8 regex instances (the 8 \textsc  {Sit} rules of Table~\ref {tab:datasets}, expanded into their comb variants) at each scanned document length $L_T$. The total regex size (sum of pattern $+$ keyword bytes over all instances, each sub-pattern counted once) is fixed at 9,600\,B. The last row derives the unit cost $u = t_{\text  {prove}} / (L_T \cdot \DOTSB \sum@ \slimits@ s)$ in seconds per (input-byte $\times $ regex-byte). Rows marked $^\dagger $ have no real measurement at that length in this log (e.g.\ a dry-run sweep with a smaller \texttt  {VEC\_SIZE}) -- all four totals are linearly interpolated from the 1{,}000\,B row, under a linear-growth assumption matching Zombie's per-byte circuit complexity; treat them as illustrative, not measured.}}{4}{table.9}\protected@file@percent }
\newlabel{tab:zombie-data}{{9}{4}{Zombie prover cost on the MS-DLP international SIT rules (Spartan NIZK, two-pattern proximity circuit), totalled over all 8 regex instances (the 8 \textsc {Sit} rules of Table~\ref {tab:datasets}, expanded into their comb variants) at each scanned document length $L_T$. The total regex size (sum of pattern $+$ keyword bytes over all instances, each sub-pattern counted once) is fixed at 9,600\,B. The last row derives the unit cost $u = t_{\text {prove}} / (L_T \cdot \sum s)$ in seconds per (input-byte $\times $ regex-byte). Rows marked $^\dagger $ have no real measurement at that length in this log (e.g.\ a dry-run sweep with a smaller \texttt {VEC\_SIZE}) -- all four totals are linearly interpolated from the 1{,}000\,B row, under a linear-growth assumption matching Zombie's per-byte circuit complexity; treat them as illustrative, not measured}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Projected Zombie cost (unit $\bar  u = 1.76 \times 10^{-6}$ s\,B$^{-2}$, taken at $L_T=2,000$) vs.\ BORA's net main-circuit folding cost. $\text  {Est.\ Zombie} = \bar  u \cdot (\text  {corpus})\cdot (\text  {regex set})$, a full document~$\times $~regex cross product. Regex-set size is on-disk rule-file bytes for \textsc  {Mal}/\textsc  {Dna}; for \textsc  {Dlp} it is the pattern$+$keyword bytes fed to the circuit (the on-disk \texttt  {.regex} doubles each sub-pattern for the bidirectional proximity form). $\bar  u$ itself is linearly interpolated (see Table~\ref {tab:zombie-data}'s $\dagger $ note): this log has no real measurement at $L_T=2,000$, e.g.\ a dry-run sweep. The \textsc  {Mal} (ClamAV) BORA cost $0.11$\,hr is the total over its $2$ parallel jobs; the wall-clock time is $0.09$\,hr (the slowest job). The \textsc  {Dlp} (Enron) BORA cost $0.04$\,hr is the total over its $2$ parallel jobs; the wall-clock time is $0.02$\,hr (the slowest job).}}{5}{table.10}\protected@file@percent }
\newlabel{tab:compare-zombie-bora}{{10}{5}{Projected Zombie cost (unit $\bar u = 1.76 \times 10^{-6}$ s\,B$^{-2}$, taken at $L_T=2,000$) vs.\ BORA's net main-circuit folding cost. $\text {Est.\ Zombie} = \bar u \cdot (\text {corpus})\cdot (\text {regex set})$, a full document~$\times $~regex cross product. Regex-set size is on-disk rule-file bytes for \textsc {Mal}/\textsc {Dna}; for \textsc {Dlp} it is the pattern$+$keyword bytes fed to the circuit (the on-disk \texttt {.regex} doubles each sub-pattern for the bidirectional proximity form). $\bar u$ itself is linearly interpolated (see Table~\ref {tab:zombie-data}'s $\dagger $ note): this log has no real measurement at $L_T=2,000$, e.g.\ a dry-run sweep. The \textsc {Mal} (ClamAV) BORA cost $0.11$\,hr is the total over its $2$ parallel jobs; the wall-clock time is $0.09$\,hr (the slowest job). The \textsc {Dlp} (Enron) BORA cost $0.04$\,hr is the total over its $2$ parallel jobs; the wall-clock time is $0.02$\,hr (the slowest job)}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces End-to-end prover cost of Zombie~\cite  {Zombie23}, Reef~\cite  {Reef}, and BORA on the three datasets of Table~\ref {tab:datasets}; the last two columns give BORA's speedup over each. Zombie costs are projected from the unit cost $u=1.76 \times 10^{-6}$~s\,B$^{-2}$ (Table~\ref {tab:zombie-data}). For \textsc  {Dna}, Reef's as-implemented cost is shown with its optimistic floor in parentheses. Values marked $^{*}$ are projected from Reef's cheapest measured per-run cost on \textsc  {Dna} ($5.09$\,s, the \texttt  {proj\_512k} bucket): the \textsc  {Dna} floor as that cost per signature, and Reef \textsc  {Mal}/\textsc  {Dlp} as that cost per signature per corpus byte (Table~\ref {tab:dna-reef-bora}). \textsc  {Mal} BORA is the total net cost summed over $2$ parallel jobs. \textsc  {Dlp} BORA is the total net cost summed over $2$ parallel jobs. Cells shown as ``??'' have no audited measurement yet.}}{5}{table.11}\protected@file@percent }
\newlabel{tab:compare-all}{{11}{5}{End-to-end prover cost of Zombie~\cite {Zombie23}, Reef~\cite {Reef}, and BORA on the three datasets of Table~\ref {tab:datasets}; the last two columns give BORA's speedup over each. Zombie costs are projected from the unit cost $u=1.76 \times 10^{-6}$~s\,B$^{-2}$ (Table~\ref {tab:zombie-data}). For \textsc {Dna}, Reef's as-implemented cost is shown with its optimistic floor in parentheses. Values marked $^{*}$ are projected from Reef's cheapest measured per-run cost on \textsc {Dna} ($5.09$\,s, the \texttt {proj\_512k} bucket): the \textsc {Dna} floor as that cost per signature, and Reef \textsc {Mal}/\textsc {Dlp} as that cost per signature per corpus byte (Table~\ref {tab:dna-reef-bora}). \textsc {Mal} BORA is the total net cost summed over $2$ parallel jobs. \textsc {Dlp} BORA is the total net cost summed over $2$ parallel jobs. Cells shown as ``??'' have no audited measurement yet}{table.11}{}}
