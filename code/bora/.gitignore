target/*
log.txt
*.out
session.log

# python bytecode
__pycache__/
*.pyc

# AI-assistant configs: kept locally, not shipped in the artifact
CLAUDE.md
**/CLAUDE.md
.gemini/
.claude/*

# sde_aggressive M0 baselines + fixtures (local-only, not committed)
data/baselines/
data/debug/sde_aggressive/

# vendored aho-corasick benchmark corpus: upstream excludes it from the
# published crate (see that crate's Cargo.toml `exclude`), no workspace
# member builds it, and it held the only >8MB file outside data/
crates/data_processor/dependency/aho-corasick/benchmarks/
data/src_sig/ms_dlp/docs/*.partial.jsonl

# the repo-root .gitignore's `*.txt` would otherwise keep this out of
# `git archive`, which is how prepare_open4s builds the artifact tarball
!/requirements.txt
