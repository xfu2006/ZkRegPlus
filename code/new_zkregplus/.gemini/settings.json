{
  "ui": {
    "errorVerbosity": "full",
    "footer": {
      "hideContextPercentage": false,
      "hideModelInfo": false
    }
  },
  "experimental": {
    "toolOutputMasking": {
      "enabled": true
    },
    "enableAgents": true
  },
  "tools": {
    "shell": {
      "enableShellOutputEfficiency": true
    }
  },
  "model": {
    "name": "gemini-3-flash-preview",
    "compressionThreshold": 0.2
  },
  "agents": {
    "overrides": {
      "generalist_agent": {
        "modelConfig": {
          "model": "gemini-3-flash-preview"
        }
      },
      "codebase_investigator": {
        "modelConfig": {
          "model": "gemini-3-flash-preview"
        }
      }
    }
  },
  "telemetry": {
    "enabled": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  }
}
